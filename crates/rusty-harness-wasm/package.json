{
  "name": "rusty-harness",
  "version": "0.1.0",
  "description": "A tiny agent harness that's blazing fast \u2014 WebAssembly build of the Rust core.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MadaraUchiha-314/rusty-harness.git",
    "directory": "crates/rusty-harness-wasm"
  },
  "homepage": "https://madarauchiha-314.github.io/rusty-harness/",
  "type": "module",
  "files": [
    "dist"
  ],
  "sideEffects": [
    "./dist/bundler/rusty_harness.js",
    "./dist/web/rusty_harness.js"
  ],
  "types": "./dist/bundler/rusty_harness.d.ts",
  "exports": {
    ".": {
      "types": "./dist/bundler/rusty_harness.d.ts",
      "node": "./dist/nodejs/rusty_harness.js",
      "default": "./dist/bundler/rusty_harness.js"
    },
    "./web": {
      "types": "./dist/web/rusty_harness.d.ts",
      "default": "./dist/web/rusty_harness.js"
    }
  },
  "scripts": {
    "build": "bun scripts/build.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "vite": "^8",
    "vitest": "^5"
  }
}
