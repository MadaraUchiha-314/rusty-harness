{
  "name": "rusty-harness-web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "test:strings": "vitest run --dir src --testNamePattern strings",
    "test:contract": "vitest run --config vitest.node.config.ts tests/contract.test.ts",
    "copy:elements": "bun scripts/copy-elements.ts",
    "test:bundle-scan": "bun run build && vitest run --config vitest.node.config.ts tests/bundle-scan.test.ts",
    "test:visual": "playwright test --project visual --project phone",
    "test:visual:update": "playwright test --project visual --project phone --update-snapshots",
    "test:a11y": "playwright test --project a11y",
    "capture": "PW_VIDEO=1 bun scripts/capture.ts",
    "test:visual:container": "bash scripts/visual-in-container.sh",
    "test:e2e": "playwright test --project e2e"
  },
  "dependencies": {
    "@a2a-js/sdk": "^1.3.0",
    "@a2ui/react": "^0.14",
    "@a2ui/web_core": "^0.14",
    "@radix-ui/react-use-controllable-state": "^1.3.0",
    "ai": "^7",
    "class-variance-authority": "^0.7",
    "clsx": "^2.1",
    "cmdk": "^1.1.1",
    "intl-messageformat": "^12",
    "lucide-react": "^1.61",
    "motion": "^14.6.0",
    "nanoid": "^6.0.2",
    "radix-ui": "^1.8",
    "react": "^19.3",
    "react-dom": "^19.3",
    "shiki": "^4.5.0",
    "streamdown": "^2.7",
    "tailwind-merge": "^3.7",
    "use-stick-to-bottom": "^1.1.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14",
    "@playwright/test": "^1.64",
    "@tailwindcss/vite": "^4.3",
    "@testing-library/jest-dom": "^7",
    "@testing-library/react": "^16.3",
    "@testing-library/user-event": "^14.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1",
    "jsdom": "^30",
    "tailwindcss": "^4.3",
    "tw-animate-css": "^1.4",
    "vite": "^8.3",
    "vitest": "^5.0.5"
  }
}
